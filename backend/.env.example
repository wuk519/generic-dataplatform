DATABASE_URL=postgresql+asyncpg://dataplatform:dataplatform@localhost:5432/dataplatform
SECRET_KEY=change-me-to-a-long-random-string-please
JWT_EXPIRES_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]

# Auto-bootstrap admin on first run. If a user with this username already
# exists, nothing happens (change the password via `python -m scripts.create_admin`).
# Leave ADMIN_PASSWORD blank in production and bootstrap manually.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
